{
  "docgen-mcp-server": {
    "command": "npx",
    "args": ["-y", "@cyanheads/docgen-mcp-server"],
    "env_vars": [
      "DOCGEN_DOCUMENT_TTL_SECONDS",
      "DOCGEN_MAX_DOCUMENT_BYTES",
      "DOCGEN_RENDER_TIMEOUT_MS",
      "DOCGEN_INLINE_MAX_BYTES",
      "DOCGEN_PDF_ENGINE"
    ],
    "env": {
      "MCP_TRANSPORT_TYPE": "stdio"
    }
  }
}
