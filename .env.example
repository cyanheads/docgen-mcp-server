# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)
# MCP_REQUEST_STATE_KEY=            # Optional >=32-byte key sealing multi-round request state;
                                    # unused by docgen's current single-round tools

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# MCP_SESSION_MODE=stateless        # docgen declares stateless in src/index.ts; an env value overrides it.
                                    # Documents live in tenant-scoped storage, not the session store.
                                    # Use stateful if a tool asks for input via ctx.requestInput.
# MCP_HTTP_RESUMABILITY=false       # SSE replay on a dropped stateful stream. Default: true.
                                    # Kill switch only — no effect on stateless serving.
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per session, oldest evicted first
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000
# LOG_TOOL_FAILURE_PAYLOADS=false            # Log failed arguments/results, key-name redaction only;
                                             # secrets inside free-form values are kept. Reaches all log sinks.
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384   # Per-payload UTF-8 byte cap
# LOG_LLM_INTERACTIONS=false                 # Full OpenRouter bodies in interactions.log (may contain secrets)

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # Base URL: traces → /v1/traces, metrics → /v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Overrides the base for traces; used as-is
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Overrides the base for metrics; used as-is
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # Opt-in log export; the base never enables it

# ── Document rendering (DOCGEN_*) ─────────────────────────────────────
# All optional — docgen runs with no required environment variables.
# DOCGEN_DOCUMENT_TTL_SECONDS=900     # How long a rendered document stays retrievable before it expires, in seconds (default: 900)
# DOCGEN_MAX_DOCUMENT_BYTES=26214400  # Hard ceiling on a single rendered artifact in bytes; exceeding it aborts the render (default: 26214400 = 25 MiB)
# DOCGEN_RENDER_TIMEOUT_MS=30000      # Per-render wall-clock budget in milliseconds; exceeding it aborts the render (default: 30000)
# DOCGEN_INLINE_MAX_BYTES=5242880     # Artifacts at or under this byte size are returned inline as base64; larger ones omit it (default: 5242880 = 5 MiB)
# DOCGEN_PDF_ENGINE=lightweight       # PDF engine; only 'lightweight' is implemented ('chromium' is reserved and rejected at startup) (default: lightweight)
